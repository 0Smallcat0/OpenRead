{
  "name": "openread",
  "version": "2.23.0",
  "description": "Translate web pages, PDFs and text on your own machine - Chrome's built-in on-device model by default, a local LLM through Ollama when you want one. Browser extension, CLI, and MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:cli": "node scripts/build-cli.mjs",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:markers": "tsx scripts/gen-zh-markers.ts",
    "release:notes": "tsx scripts/release-notes.ts",
    "eval": "tsx eval/run.ts",
    "eval:capture": "tsx eval/capture-run.ts",
    "eval:structured": "tsx eval/structured/run.ts",
    "bench": "tsx eval/bench/run.ts",
    "bench:agreement": "tsx eval/bench/agreement.ts",
    "e2e:page": "node e2e/fullpage.mjs",
    "e2e:epub": "node e2e/epub.mjs",
    "e2e:first-run": "node e2e/first-run.mjs",
    "e2e:prefetch": "node e2e/prefetch.mjs",
    "e2e:page-pack": "node e2e/page-pack.mjs",
    "e2e:selection": "node e2e/selection.mjs",
    "e2e:stress": "node e2e/stress.mjs",
    "e2e:egress": "node e2e/no-egress.mjs",
    "cli": "pnpm build:cli && node bin/openread.mjs",
    "prepare": "wxt prepare && node scripts/build-cli.mjs",
    "prepack": "node scripts/build-cli.mjs",
    "shoot": "node scripts/shoot-assets.mjs",
    "eval:builtin": "node eval/builtin/collect.mjs && tsx eval/builtin/report.ts",
    "eval:builtin:report": "tsx eval/builtin/report.ts",
    "check": "node scripts/hand-check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "gifenc": "^1.0.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "puppeteer-core": "^24.30.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@types/opencc-js": "^1.0.3",
    "opencc-js": "^1.4.0"
  },
  "bin": {
    "openread": "bin/openread.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/node/cli.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "ollama",
    "translation",
    "local-llm",
    "mcp",
    "mcp-server",
    "cli",
    "chrome-extension",
    "traditional-chinese",
    "privacy",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Smallcat0/OpenRead.git"
  },
  "homepage": "https://github.com/0Smallcat0/OpenRead#readme",
  "main": "./dist/node/cli.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/0Smallcat0/OpenRead/issues"
  }
}
