{
  "name": "openread",
  "version": "2.2.11",
  "description": "Local-first, evaluation-driven LLM translation for web & PDF via Ollama — a case study in making streaming LLM output reliable.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:markers": "tsx scripts/gen-zh-markers.ts",
    "eval": "tsx eval/run.ts",
    "eval:capture": "tsx eval/capture-run.ts",
    "eval:structured": "tsx eval/structured/run.ts",
    "bench": "tsx eval/bench/run.ts",
    "bench:agreement": "tsx eval/bench/agreement.ts",
    "postinstall": "wxt prepare",
    "harness": "vite harness --port 5177 --strictPort"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@types/opencc-js": "^1.0.3",
    "opencc-js": "^1.4.0"
  }
}
